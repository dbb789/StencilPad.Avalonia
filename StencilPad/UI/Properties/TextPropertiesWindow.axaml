<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StencilPad.UI.Properties.TextPropertiesWindow"
        xmlns:vm="clr-namespace:StencilPad.ViewModels.Properties"
        xmlns:widgets="using:StencilPad.UI.Widgets"
        x:DataType="vm:TextPropertiesViewModel"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        MinWidth="300">
    <Grid Margin="12" IsEnabled="{Binding HasElements}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <widgets:TextProperties Grid.Row="0"
                                TextFontName="{Binding FontName}"
                                TextFontSize="{Binding FontSize}"/>

        <TextBlock Grid.Row="2" Text="Colour:"/>
        <widgets:ColorField x:Name="ColorField"
                            Grid.Row="4"
                            Value="{Binding Color}"/>

        <Button Grid.Row="6"
                Content="Close"
                MinWidth="75"
                HorizontalAlignment="Right"
                Click="Close_Click"/>
    </Grid>
</Window>
