<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StencilPad.UI.Dialogs.GridSettingsDialog"
        xmlns:widgets="clr-namespace:StencilPad.UI.Widgets"
        Title="Grid Settings" SizeToContent="WidthAndHeight"
        CanResize="False" WindowStartupLocation="CenterOwner"
        MinWidth="300">
    <Grid Margin="12"
          RowDefinitions="Auto,8,Auto,8,Auto,12,Auto"
          ColumnDefinitions="Auto,12,*">

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Spacing:"
                   VerticalAlignment="Center"/>
        <widgets:UnitField x:Name="SpacingField"
                           Grid.Row="0" Grid.Column="2"
                           MinWidth="160"
                           UnitSettings="{Binding UnitSettings}"
                           Value="{Binding Spacing}"/>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subdivisions:"
                   VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="2"
                 MinHeight="20"
                 Text="{Binding Subdivisions}"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"     IsDefault="True" MinWidth="75" Margin="0,0,8,0" Click="OK_Click"/>
            <Button Content="Cancel" IsCancel="True"  MinWidth="75" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
