<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:StencilPad.UI.Widgets"
             x:Class="StencilPad.UI.Widgets.GeometryDropdown"
             x:Name="Root">
    <ComboBox x:Name="Dropdown"
              ItemsSource="{Binding Items, ElementName=Root}"
              SelectedIndex="{Binding SelectedIndex, ElementName=Root, Mode=TwoWay}"
              HorizontalAlignment="Stretch">
    <ComboBox.ItemTemplate>
      <DataTemplate>
          <widgets:GeometryDropdownItem x:DataType="{x:Type widgets:GeometryDropdownEntry}"
                                        Path="{Binding Path}"
                                        Paint="{Binding Paint}"
                                        Height="22"/>
      </DataTemplate>
    </ComboBox.ItemTemplate>
  </ComboBox>
</UserControl>
