<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:StencilPad.UI.Widgets"
             x:Class="StencilPad.UI.Widgets.GeometryDropdown"
             x:Name="Root">
  <ComboBox x:Name="Dropdown"
            SelectionChanged="Dropdown_SelectionChanged">
    <ComboBox.ItemTemplate>
      <DataTemplate>
        <Viewbox Height="16" StretchDirection="DownOnly" Stretch="Uniform">
          <Grid Width="80" Height="16">
            <widgets:GeometryDropdownItem Path="{Binding Path}"/>
          </Grid>
        </Viewbox>
      </DataTemplate>
    </ComboBox.ItemTemplate>
  </ComboBox>
</UserControl>
