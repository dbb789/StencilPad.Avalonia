<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StencilPad.UI.Widgets"
             x:Class="StencilPad.UI.Widgets.Unit2DField"
             x:Name="Root">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="132" />
      <ColumnDefinition Width="2" />
      <ColumnDefinition Width="132" />
      <ColumnDefinition Width="2" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <local:BaseUnitField x:Name="ValueXField"
                         Grid.Column="0"
                         VerticalContentAlignment="Center"
                         Value="{Binding ValueX, ElementName=Root, Mode=TwoWay}"
                         UnitType="{Binding UnitType, ElementName=Root, Mode=TwoWay}"
                         UnitSettings="{Binding UnitSettings, ElementName=Root}"
                         Minimum="{Binding Minimum, ElementName=Root}"
                         Maximum="{Binding Maximum, ElementName=Root}"
                         Scaled="{Binding Scaled, ElementName=Root}" />

    <local:BaseUnitField x:Name="ValueYField"
                         Grid.Column="2"
                         VerticalContentAlignment="Center"
                         Value="{Binding ValueY, ElementName=Root, Mode=TwoWay}"
                         UnitType="{Binding UnitType, ElementName=Root, Mode=TwoWay}"
                         UnitSettings="{Binding UnitSettings, ElementName=Root}"
                         Minimum="{Binding Minimum, ElementName=Root}"
                         Maximum="{Binding Maximum, ElementName=Root}"
                         Scaled="{Binding Scaled, ElementName=Root}" />

    <ComboBox x:Name="UnitTypeComboBox"
              Grid.Column="4"
              Margin="0"
              CornerRadius="0"
              Width="72"
              SelectionChanged="UnitTypeComboBox_SelectionChanged" />
  </Grid>
</UserControl>
