<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:widgets="using:StencilPad.UI.Widgets"
             x:Class="StencilPad.UI.Widgets.BaseUnitField"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="ButtonSpinner.BaseUnitField /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
        </Style>
        
        <Style Selector="ButtonSpinner.BaseUnitField /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="BorderThickness" Value="0,1,1,1"/>
        </Style>

    </UserControl.Styles>
    
    <ButtonSpinner x:Name="Spinner" Classes="BaseUnitField" Spin="Spinner_Spin"
                   Margin="0"
                   Padding="0"
                   BorderThickness="0">
        <TextBox x:Name="ValueField"
                 KeyDown="ValueField_KeyDown"
                 LostFocus="ValueField_LostFocus"
                 CornerRadius="0"/>
    </ButtonSpinner>
</UserControl>
